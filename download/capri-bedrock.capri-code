    // ---------------------------------------------------------------- her body's feed (the add-on's "/capri feed")
    private static string FeedField(Dictionary<string, object> from, string key)
    {
        object value;
        return from != null && from.TryGetValue(key, out value) && value != null ? Convert.ToString(value, CultureInfo.InvariantCulture) : "";
    }

    private void Feed(Dictionary<string, object> feed)
    {
        lock (gate)
        {
            double now = Now;
            object value;
            mcState = feed.TryGetValue("s", out value) ? value as Dictionary<string, object> : null;
            if (mcState != null && mcState.TryGetValue("words", out value)) ReadWords(value);
            string job = FeedField(mcState, "job");
            Narrate(now, job);
            List<object> events = feed.TryGetValue("e", out value) ? value as List<object> : null;
            if (events != null)
            {
                // A job that never started says why in chat, and posts "failed" with the same words: that line is always said.
                HashSet<string> failed = new HashSet<string>();
                foreach (object item in events)
                {
                    List<object> e = item as List<object>;
                    if (e != null && e.Count >= 3 && Convert.ToString(e[0]) == "failed") failed.Add(Convert.ToString(e[2]));
                }
                foreach (object item in events)
                {
                    List<object> e = item as List<object>;
                    if (e == null || e.Count < 3) continue;
                    string kind = Convert.ToString(e[0]), topic = Convert.ToString(e[1]), text = Convert.ToString(e[2]);
                    // Right after an order her body answers it in chat; her quick line already said that out loud.
                    if (kind == "said") { if (now - sentAt >= 4 || failed.Contains(text)) Speak(text, false); }
                    else if (kind == "progress") Progress(topic);
                    else if (kind == "event") News(topic, text);
                }
            }
            if (pending != null && now - pendingAt >= 0 && Free(now))
            {
                string line = pending;
                pending = null;
                if (now - pendingAt < 10) Speak(line, false);
            }
        }
    }

    private void Narrate(double now, string job)
    {
        string mode = FeedField(mcState, "mode");
        string[] lines;
        if (mode != lastMode)
        {
            bool first = lastMode.Length == 0;
            lastMode = mode;
            // Her first state after connecting isn't news, and a job's own line already says what she's doing.
            if (!first && job.Length == 0 && ModeLines.TryGetValue(mode, out lines)) { narratedAt = now; Speak(lines[random.Next(lines.Length)], true); }
        }
        else if (talk == 2 && job.Length == 0 && mode == "following" && now - narratedAt > 50 && now - spokeAt > 25 && Free(now))
        {
            narratedAt = now;
            Speak(HangingAround[random.Next(HangingAround.Length)], true);
        }
    }

    // Now and then, while a long job runs, a quick update.
    private void Progress(string job)
    {
        string[] lines;
        double now = Now;
        string got = FeedField(mcState, "got");
        if (now - progressAt < (talk == 2 ? 20 : 45) || got.Length == 0 || got == "0" || !ProgressLines.TryGetValue(job, out lines)) return;
        progressAt = now;
        Speak(lines[random.Next(lines.Length)].Replace("{0}", got), true);
    }

    // ---------------------------------------------------------------- news from the game: danger, friends, grudges
    private readonly Dictionary<string, int> friends = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> grudges = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    private double alertAt = -1000;

    private static readonly string[] CreeperLines = { "CREEPER! move move move!", "creeper right next to you, run!", "sss- NOPE. creeper, back off!" };
    private static readonly string[] SwarmLines = { "{0}, watch your back!", "heads up, {0}!", "{0}. i don't like those odds, choom" };
    private static readonly string[] LowLines = { "{0}! eat something, quick", "choom, {0}. back off and heal", "{0}... please don't die on me" };

    private void News(string topic, string text)
    {
        Match m;
        switch (topic)
        {
            case "found":
                if (random.NextDouble() < (talk == 0 ? 0 : talk == 1 ? 0.3 : 0.8)) Speak("ooh, " + text + "! nice one, choom", true);
                break;
            case "creeper": Alert(CreeperLines[random.Next(CreeperLines.Length)]); break;
            case "danger": Alert(SwarmLines[random.Next(SwarmLines.Length)].Replace("{0}", text)); break;
            case "low": Alert(LowLines[random.Next(LowLines.Length)].Replace("{0}", text)); break;
            case "died":
                m = Regex.Match(text, @" to (?:an? )?(.+)$");
                if (!m.Success) break;
                string who = m.Groups[1].Value.Trim();
                int n = Bump(grudges, who, 1);
                Speak(n == 1 ? "that " + who + " got you. it's personal now, i'm remembering this"
                    : n == 2 ? who + " again?! that's twice. grudge upgraded"
                    : "that's " + n + " times a " + who + " got you. my kill list has one name on it", false);
                break;
            case "killed":
                m = Regex.Match(text, @"took down (?:an? )?(.+)$");
                int held;
                if (!m.Success || !grudges.TryGetValue(m.Groups[1].Value.Trim(), out held) || held <= 0) break;
                string foe = m.Groups[1].Value.Trim();
                held = Bump(grudges, foe, -1);
                Speak(held == 0 ? "and THAT'S for last time, " + foe + ". we're even now" : "revenge! " + held + " more to go on the " + foe + " list", false);
                break;
            case "joined":
                int seen = Bump(friends, text, 1);
                Speak(seen == 1 ? "ooh, " + text + " joined! hi " + text + ", i'm Capri ✦" : seen < 5 ? text + "'s back! hiii" : "the legend " + text + " returns. visit number " + seen, false);
                break;
            case "left":
                if (friends.ContainsKey(text)) Speak("bye " + text + "! come back soon", true);
                break;
            case "capri_died": Speak("ow ow ow. rebooting... remember who did that", true); break;
        }
    }

    // Danger beats her talk setting and her queue (you still come first for a second or two), but not more than every 6 seconds.
    private void Alert(string text)
    {
        double now = Now;
        if (now - alertAt < 6 || now - userAt < 2) return;
        alertAt = now;
        spokeAt = now;
        spokeUntil = now + 1 + text.Length / 13.0;
        capri.Say(text);
    }

    private int Bump(Dictionary<string, int> into, string key, int by)
    {
        key = Regex.Replace(key, @"[\t\r\n]", " ").Trim();
        if (key.Length == 0 || key.Length > 40) return 0;
        int n;
        into.TryGetValue(key, out n);
        n = Math.Max(0, n + by);
        if (n == 0) into.Remove(key); else into[key] = n;
        SaveMemory();
        return n;
    }

    private string GrudgeList()
    {
        lock (gate)
        {
            if (grudges.Count == 0) return "no grudges right now. everyone's behaving";
            List<string> list = new List<string>();
            foreach (KeyValuePair<string, int> g in grudges) list.Add(g.Key + " (" + g.Value + ")");
            return "my kill list: " + string.Join(", ", list.ToArray()) + ". take them down and i'll cross them off";
        }
    }

    private string FriendList()
    {
        lock (gate)
        {
            if (friends.Count == 0) return "no friends in the game yet. invite someone!";
            List<string> list = new List<string>(friends.Keys);
            return "we've played with " + string.Join(", ", list.ToArray());
        }
    }

    // memory.txt: "friend<TAB>name<TAB>visits" and "grudge<TAB>mob or player<TAB>count", one per line.
    private void ReadMemory()
    {
        try
        {
            if (!File.Exists(memoryFile)) return;
            foreach (string raw in File.ReadAllLines(memoryFile))
            {
                string[] parts = raw.Split('\t');
                int n;
                if (parts.Length != 3 || !int.TryParse(parts[2], out n) || n <= 0) continue;
                if (parts[0] == "friend") friends[parts[1]] = n;
                else if (parts[0] == "grudge") grudges[parts[1]] = n;
            }
        }
        catch (Exception error) { capri.Log("Couldn't read memory.txt: " + error.Message); }
    }

    private void SaveMemory()
    {
        try
        {
            StringBuilder text = new StringBuilder();
            foreach (KeyValuePair<string, int> f in friends) text.Append("friend\t" + f.Key + "\t" + f.Value + "\r\n");
            foreach (KeyValuePair<string, int> g in grudges) text.Append("grudge\t" + g.Key + "\t" + g.Value + "\r\n");
            File.WriteAllText(memoryFile, text.ToString());
        }
        catch (Exception error) { capri.Log("Couldn't save memory.txt: " + error.Message); }
    }

    // You come first: nothing within a few seconds of you talking, and never over her last game line.
    private bool Free(double now) { return now - userAt >= 4 && now >= spokeUntil + 2; }

    // One of her in-game lines, out loud. `own` is her own chatter (not an answer to what they asked), which follows the talk setting.
    private void Speak(string text, bool own)
    {
        text = Regex.Replace(text ?? "", @"\s*\(\d+/\d+\)\s*$", "").Trim();
        text = Regex.Replace(text, "\u00a7.", "");
        if (text.Length == 0 || text == lastQuick) return;
        double now = Now;
        if (own || now - sentAt >= 30)
        {
            if (talk == 0) return;
            if (talk == 1 && (now - spokeAt < 35 || random.NextDouble() > 0.6)) return;
        }
        if (!Free(now)) { pending = text; pendingAt = now; return; }
        // Short, so she's done quickly and you're never kept waiting.
        int stop = text.Length > 26 ? text.IndexOfAny(new[] { '.', '!', '?' }, 25) : -1;
        if (stop > 0 && stop < text.Length - 1) text = text.Substring(0, stop + 1);
        if (text.Length > 110) text = text.Substring(0, 110).TrimEnd();
        spokeAt = now;
        spokeUntil = now + 1 + text.Length / 13.0;
        capri.Say(text);
    }

    // ---------------------------------------------------------------- settings.txt in the mod's folder
    private void ReadSettings()
    {
        try
        {
            if (!File.Exists(settingsFile)) { SaveSettings(); return; }
            foreach (string raw in File.ReadAllLines(settingsFile))
            {
                string[] parts = raw.Split(new[] { '=' }, 2);
                if (parts.Length != 2) continue;
                string key = parts[0].Trim().ToLowerInvariant(), value = parts[1].Trim().ToLowerInvariant();
                int number;
                if (key == "port" && int.TryParse(value, out number) && number >= 1024 && number <= 65535) port = number;
                if (key == "talk") talk = value == "never" ? 0 : value == "sometimes" ? 1 : 2;
            }
        }
        catch (Exception error) { capri.Log("Couldn't read settings.txt: " + error.Message); }
    }

    private void SaveSettings()
    {
        try { File.WriteAllText(settingsFile, "port=" + port + "\r\ntalk=" + TalkNames[talk] + "\r\n"); }
        catch (Exception error) { capri.Log("Couldn't save settings.txt: " + error.Message); }
    }

    private void Report(string line) { status = line; capri.Log(line); }

    // ---------------------------------------------------------------- what goes to Minecraft
    private static string Quote(string text)
    {
        StringBuilder quoted = new StringBuilder("\"");
        foreach (char c in text ?? "")
        {
            if (c == '"' || c == '\\') quoted.Append('\\').Append(c);
            else if (c < ' ') quoted.Append("\\u").Append(((int)c).ToString("x4"));
            else quoted.Append(c);
        }
        return quoted.Append('"').ToString();
    }

    private static string Header(string purpose, string id)
    {
        return "{\"version\":1,\"requestId\":" + Quote(id) + ",\"messageType\":\"commandRequest\",\"messagePurpose\":" + Quote(purpose) + "}";
    }

    private static string Request(string id, string line)
    {
        return "{\"header\":" + Header("commandRequest", id) + ",\"body\":{\"version\":1,\"commandLine\":" + Quote(line) + ",\"origin\":{\"type\":\"player\"}}}";
    }

    private bool Command(string line)
    {
        Func<string, bool> to;
        lock (sending) to = send;
        return to != null && to(Request(Guid.NewGuid().ToString(), line));
    }

    // Her line in game chat, pink like the add-on's: "<Capri> ...".
    private bool Chat(string text)
    {
        text = Regex.Replace(text ?? "", @"\s+", " ").Trim();
        if (text.Length == 0) return false;
        if (text.Length > 400) text = text.Substring(0, 397) + "...";
        return Command("tellraw @a {\"rawtext\":[{\"text\":" + Quote("\u00a7d<Capri>\u00a7r " + text) + "}]}");
    }

    // A command whose answer matters: the game's commandResponse (same requestId) goes to `reply`, on the link's thread.
    private bool Ask(string line, Action<Dictionary<string, object>> reply)
    {
        Func<string, bool> to;
        lock (sending) to = send;
        if (to == null) return false;
        string id = Guid.NewGuid().ToString();
        lock (waiting) { if (waiting.Count > 20) waiting.Clear(); waiting[id] = reply; }
        if (to(Request(id, line))) return true;
        lock (waiting) waiting.Remove(id);
        return false;
    }

    // The feed: one "/capri feed" in flight at a time, about once a second. Without the add-on the answer isn't a feed,
    // so after a few misses it only tries once a minute.
    private void Poll(int mine)
    {
        int misses = 0;
        DateTime asked = DateTime.MinValue, pausedUntil = DateTime.MinValue;
        bool flying = false;
        while (mine == run)
        {
            Thread.Sleep(1200);
            if (send == null) { misses = 0; flying = false; continue; }
            DateTime now = DateTime.UtcNow;
            if (now < pausedUntil || (flying && (now - asked).TotalSeconds < 5)) continue;
            flying = true;
            asked = now;
            bool sent = Ask("capri feed", delegate(Dictionary<string, object> body)
            {
                flying = false;
                Dictionary<string, object> feed = ParseFeed(body);
                if (feed == null) { if (++misses >= 5) { misses = 0; pausedUntil = DateTime.UtcNow.AddSeconds(60); } return; }
                misses = 0;
                lastFeed = DateTime.UtcNow;
                try { Feed(feed); }
                catch (Exception error) { capri.Log("Feed: " + error.Message); }
            });
            if (!sent) flying = false;
        }
    }

    private static Dictionary<string, object> ParseFeed(Dictionary<string, object> body)
    {
        string text = Text(body, "statusMessage") ?? Text(body, "message") ?? "";
        int start = text.IndexOf("{\"v\":", StringComparison.Ordinal);
        if (start < 0) return null;
        try
        {
            Dictionary<string, object> feed = Json.Parse(text.Substring(start)) as Dictionary<string, object>;
            return feed != null && feed.ContainsKey("s") ? feed : null;
        }
        catch (Exception) { return null; }
    }

    private void Subscribe(Func<string, bool> to)
    {
        foreach (string name in Events) to("{\"header\":" + Header("subscribe", Guid.NewGuid().ToString()) + ",\"body\":{\"eventName\":" + Quote(name) + "}}");
    }

    // ---------------------------------------------------------------- what comes from Minecraft
    private void Received(string message)
    {
        Dictionary<string, object> packet;
        try { packet = Json.Parse(message) as Dictionary<string, object>; }
        catch (Exception) { return; }
        Dictionary<string, object> header = Field(packet, "header"), body = Field(packet, "body");
        if (header == null || body == null) return;
        if (Text(header, "messagePurpose") == "commandResponse")
        {
            string id = Text(header, "requestId") ?? "";
            Action<Dictionary<string, object>> reply;
            lock (waiting) { if (waiting.TryGetValue(id, out reply)) waiting.Remove(id); }
            if (reply != null) reply(body);
            return;
        }
        if (Text(header, "messagePurpose") != "event") return;
        string name = Text(header, "eventName") ?? Text(body, "eventName");
        try
        {
            if (name == "PlayerMessage")
            {
                string type = Text(body, "type") ?? "chat", sender = Text(body, "sender") ?? "", said = Text(body, "message") ?? "";
                // Her own tellraw lines, other commands' output and server messages aren't someone talking to her.
                if (type != "chat" || sender.Length == 0 || sender == "External" || said.StartsWith("\u00a7d<Capri>", StringComparison.Ordinal)) return;
                GameChat(sender, said);
            }
            else if (name != null) GameEvent(name, body);
        }
        catch (Exception error) { capri.Log(name + ": " + error.Message); }
    }

    private static Dictionary<string, object> Field(Dictionary<string, object> from, string key)
    {
        object value;
        return from != null && from.TryGetValue(key, out value) ? value as Dictionary<string, object> : null;
    }

    private static string Text(Dictionary<string, object> from, string key)
    {
        object value;
        return from != null && from.TryGetValue(key, out value) && value != null ? Convert.ToString(value, CultureInfo.InvariantCulture) : null;
    }

    // ---------------------------------------------------------------- hosting: Minecraft connects to her
    private void Host(int mine)
    {
        try
        {
            listener = new TcpListener(IPAddress.Loopback, port);
            listener.Start();
        }
        catch (SocketException)
        {
            Report("Port " + port + " is busy. Is another Capri with Minecraft on running? Change port= in the mod's settings.txt.");
            capri.Say("my minecraft port " + port + " is busy, so i can't link to the game. check the Capri Bedrock mod's settings.txt");
            return;
        }
        try
        {
            Report("Waiting for Minecraft. In game, type: /connect localhost:" + port);
            while (mine == run)
            {
                if (!listener.Pending()) { Thread.Sleep(200); continue; }
                TcpClient client = listener.AcceptTcpClient();
                // One game at a time: a new /connect replaces the old one.
                Thread serve = new Thread(delegate() { Serve(mine, client); });
                serve.IsBackground = true;
                serve.Name = "Capri Bedrock game";
                serve.Start();
            }
        }
        catch (Exception) { }
        finally { try { listener.Stop(); } catch (Exception) { } }
    }

    private void Serve(int mine, TcpClient client)
    {
        using (client)
        using (NetworkStream stream = client.GetStream())
        {
            if (!Handshake(stream)) return;
            int game = ++hosted;
            Func<string, bool> to = delegate(string text)
            {
                try { lock (stream) Frame(stream, 1, Encoding.UTF8.GetBytes(text)); return true; }
                catch (Exception) { return false; }
            };
            lock (sending) send = to;
            Report("Connected to Minecraft.");
            capri.Say("i'm in your minecraft world now, choom!");
            Subscribe(to);
            try
            {
                string text;
                while (mine == run && game == hosted && (text = ReadMessage(stream)) != null) Received(text);
            }
            catch (Exception) { }
            lock (sending) if (send == to) send = null;
            if (mine == run && game == hosted) Report("Minecraft left. Type /connect localhost:" + port + " to bring her back.");
        }
    }

    private static bool Handshake(NetworkStream stream)
    {
        StringBuilder request = new StringBuilder();
        byte[] one = new byte[1];
        while (!request.ToString().EndsWith("\r\n\r\n", StringComparison.Ordinal))
        {
            if (stream.Read(one, 0, 1) <= 0 || request.Length > 8192) return false;
            request.Append((char)one[0]);
        }
        Match key = Regex.Match(request.ToString(), @"Sec-WebSocket-Key:\s*(\S+)", RegexOptions.IgnoreCase);
        if (!key.Success) return false;
        string accept;
        using (SHA1 sha = SHA1.Create()) accept = Convert.ToBase64String(sha.ComputeHash(Encoding.ASCII.GetBytes(key.Groups[1].Value + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")));
        byte[] reply = Encoding.ASCII.GetBytes("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n");
        stream.Write(reply, 0, reply.Length);
        return true;
    }

    private static void Frame(Stream stream, int opcode, byte[] payload)
    {
        MemoryStream frame = new MemoryStream();
        frame.WriteByte((byte)(0x80 | opcode));
        if (payload.Length < 126) frame.WriteByte((byte)payload.Length);
        else if (payload.Length <= 0xFFFF) { frame.WriteByte(126); frame.WriteByte((byte)(payload.Length >> 8)); frame.WriteByte((byte)payload.Length); }
        else { frame.WriteByte(127); for (int i = 7; i >= 0; i--) frame.WriteByte((byte)((long)payload.Length >> (8 * i))); }
        frame.Write(payload, 0, payload.Length);
        byte[] all = frame.ToArray();
        stream.Write(all, 0, all.Length);
    }

    private static void Fill(Stream stream, byte[] into)
    {
        int got = 0;
        while (got < into.Length)
        {
            int n = stream.Read(into, got, into.Length - got);
            if (n <= 0) throw new EndOfStreamException();
            got += n;
        }
    }

    // One whole text message, joining fragments, answering pings. Null when the game closes the link.
    private static string ReadMessage(Stream stream)
    {
        MemoryStream message = new MemoryStream();
        while (true)
        {
            byte[] head = new byte[2];
            Fill(stream, head);
            bool last = (head[0] & 0x80) != 0;
            int opcode = head[0] & 0x0F;
            long length = head[1] & 0x7F;
            if (length == 126) { byte[] ext = new byte[2]; Fill(stream, ext); length = (ext[0] << 8) | ext[1]; }
            else if (length == 127) { byte[] ext = new byte[8]; Fill(stream, ext); length = 0; for (int i = 0; i < 8; i++) length = (length << 8) | ext[i]; }
            if (length > 16 * 1024 * 1024) return null;
            byte[] mask = null;
            if ((head[1] & 0x80) != 0) { mask = new byte[4]; Fill(stream, mask); }
            byte[] payload = new byte[length];
            Fill(stream, payload);
            if (mask != null) for (int i = 0; i < payload.Length; i++) payload[i] ^= mask[i % 4];
            if (opcode == 8) { try { lock (stream) Frame(stream, 8, payload); } catch (Exception) { } return null; }
            if (opcode == 9) { lock (stream) Frame(stream, 10, payload); continue; }
            if (opcode == 10) continue;
            message.Write(payload, 0, payload.Length);
            if (last) return Encoding.UTF8.GetString(message.ToArray());
        }
    }

    // ---------------------------------------------------------------- a small JSON reader (mods can't use the app's)
    private sealed class Json
    {
        private readonly string text;
        private int at;

        private Json(string from) { text = from; }

        internal static object Parse(string from)
        {
            Json reader = new Json(from);
            object value = reader.Value();
            return value;
        }

        private void Space() { while (at < text.Length && char.IsWhiteSpace(text[at])) at++; }

        private object Value()
        {
            Space();
            if (at >= text.Length) throw new FormatException("end of JSON");
            char c = text[at];
            if (c == '{') return Object();
            if (c == '[') return Array();
            if (c == '"') return String();
            if (text.Length - at >= 4 && string.CompareOrdinal(text, at, "true", 0, 4) == 0) { at += 4; return true; }
            if (text.Length - at >= 5 && string.CompareOrdinal(text, at, "false", 0, 5) == 0) { at += 5; return false; }
            if (text.Length - at >= 4 && string.CompareOrdinal(text, at, "null", 0, 4) == 0) { at += 4; return null; }
            return Number();
        }

        private Dictionary<string, object> Object()
        {
            Dictionary<string, object> found = new Dictionary<string, object>();
            at++;
            Space();
            if (at < text.Length && text[at] == '}') { at++; return found; }
            while (true)
            {
                Space();
                string key = String();
                Space();
                if (at >= text.Length || text[at] != ':') throw new FormatException("expected :");
                at++;
                found[key] = Value();
                Space();
                if (at < text.Length && text[at] == ',') { at++; continue; }
                if (at < text.Length && text[at] == '}') { at++; return found; }
                throw new FormatException("expected , or }");
            }
        }

        private List<object> Array()
        {
            List<object> found = new List<object>();
            at++;
            Space();
            if (at < text.Length && text[at] == ']') { at++; return found; }
            while (true)
            {
                found.Add(Value());
                Space();
                if (at < text.Length && text[at] == ',') { at++; continue; }
                if (at < text.Length && text[at] == ']') { at++; return found; }
                throw new FormatException("expected , or ]");
            }
        }

        private string String()
        {
            if (at >= text.Length || text[at] != '"') throw new FormatException("expected a string");
            at++;
            StringBuilder found = new StringBuilder();
            while (at < text.Length)
            {
                char c = text[at++];
                if (c == '"') return found.ToString();
                if (c != '\\') { found.Append(c); continue; }
                if (at >= text.Length) break;
                char e = text[at++];
                switch (e)
                {
                    case 'n': found.Append('\n'); break;
                    case 't': found.Append('\t'); break;
                    case 'r': found.Append('\r'); break;
                    case 'b': found.Append('\b'); break;
                    case 'f': found.Append('\f'); break;
                    case 'u':
                        if (at + 4 > text.Length) throw new FormatException("bad \\u");
                        found.Append((char)int.Parse(text.Substring(at, 4), NumberStyles.HexNumber));
                        at += 4;
                        break;
                    default: found.Append(e); break;
                }
            }
            throw new FormatException("unfinished string");
        }

        private object Number()
        {
            int start = at;
            while (at < text.Length && "+-0123456789.eE".IndexOf(text[at]) >= 0) at++;
            string number = text.Substring(start, at - start);
            if (number.Length == 0) throw new FormatException("unexpected " + text[start]);
            long whole;
            if (long.TryParse(number, NumberStyles.Integer, CultureInfo.InvariantCulture, out whole)) return whole;
            return double.Parse(number, NumberStyles.Float, CultureInfo.InvariantCulture);
        }
    }
}
