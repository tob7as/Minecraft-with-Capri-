// capri-mod: 1
// id: capri-bedrock
// name: Capri Bedrock
// version: 1.0.0
// author: tob7as
// description: Plays Minecraft Bedrock with you through the Capri Companion add-on. In game, type /connect localhost:19131.

using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Net;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using CapriDesktop;

// Bedrock's /connect talks to a websocket server. This mod hosts one on this PC (port 19131 unless settings.txt says
// otherwise), hears game chat and events, reads the add-on's "/capri feed" about once a second, and sends her jobs to her
// body in the game as "scriptevent capri:<job>". What you say or type to her is checked here first: a Minecraft order is
// sent and answered with a quick line, anything else goes to her brain as usual. Her in-game lines wait for you: never
// within a few seconds of you talking, one at a time, and Capri herself holds a line until you've finished.
public class CapriBedrock : ICapriMod
{
    private const int DefaultPort = 19131;
    private static readonly string[] Events = { "PlayerMessage", "PlayerDied", "MobKilled" };
    private static readonly string[] TalkNames = { "never", "sometimes", "a lot" };

    private ICapriHost capri;
    private string settingsFile, memoryFile;
    private int port = DefaultPort;
    private int talk = 2;                 // how much she talks about the game on her own: 0 never, 1 sometimes, 2 a lot

    private volatile int run;
    private volatile int hosted;
    private TcpListener listener;
    private readonly object sending = new object();
    private Func<string, bool> send;
    private readonly Dictionary<string, Action<Dictionary<string, object>>> waiting = new Dictionary<string, Action<Dictionary<string, object>>>();
    private DateTime lastFeed = DateTime.MinValue;
    private string status = "Starting...";

    private readonly object gate = new object();
    private readonly Stopwatch clock = Stopwatch.StartNew();
    private readonly Random random = new Random();
    private Dictionary<string, object> mcState;
    private double sentAt = -1000, spokeAt = -1000, spokeUntil = -1000, progressAt = -1000, pendingAt, userAt = -1000, narratedAt = -1000, reactedAt = -1000;
    private string pending;
    private string lastMode = "";

    private double Now { get { return clock.Elapsed.TotalSeconds; } }
    private bool Connected { get { return send != null; } }
    // True while the add-on answers the feed: then her body says its own lines in chat, so the mod doesn't repeat them there.
    private bool FeedLive { get { return send != null && (DateTime.UtcNow - lastFeed).TotalSeconds < 5; } }

    // ---------------------------------------------------------------- the mod
    public void Start(ICapriHost host)
    {
        capri = host;
        settingsFile = Path.Combine(host.Folder, "settings.txt");
        memoryFile = Path.Combine(host.Folder, "memory.txt");
        ReadSettings();
        ReadMemory();
        int mine = ++run;
        Thread worker = new Thread(delegate() { Host(mine); });
        worker.IsBackground = true;
        worker.Name = "Capri Bedrock link";
        worker.Start();
        Thread poll = new Thread(delegate() { Poll(mine); });
        poll.IsBackground = true;
        poll.Name = "Capri Bedrock feed";
        poll.Start();
    }

    public void Stop()
    {
        run++;
        lock (sending) send = null;
        TcpListener was = listener;
        if (was != null) try { was.Stop(); } catch (Exception) { }
        capri.Log("Stopped.");
    }

    // Everything they say or type to her comes here first. True means it was a Minecraft order and her brain can skip it.
    public bool Heard(string words)
    {
        string text = (words ?? "").Trim();
        lock (gate) userAt = Now;
        if (text.Length == 0) return false;

        Match level = Regex.Match(text, @"\b(?:minecraft|mc|game) talk(?:ing)?\b\W*(a ?lot|more|sometimes|less|never|off|quiet)\b", RegexOptions.IgnoreCase);
        if (level.Success)
        {
            string said = level.Groups[1].Value.ToLowerInvariant();
            talk = said.StartsWith("a") || said == "more" ? 2 : said == "sometimes" || said == "less" ? 1 : 0;
            SaveSettings();
            capri.Say(talk == 2 ? "kk, i'll talk about the game a lot" : talk == 1 ? "ok, i'll only talk about the game sometimes" : "fine, no more game chatter. i'll still answer you");
            return true;
        }
        if (Regex.IsMatch(text, @"\b(grudges?|beef|enem(y|ies)|hate list|kill list)\b.{0,30}\b(minecraft|game|mobs?|have|got|holding)\b|\bwho (do|are) (you|we) (have a )?(grudges?|beef|hate)\b|\bwhat (are )?(your|our) grudges\b", RegexOptions.IgnoreCase))
        {
            capri.Say(GrudgeList());
            return true;
        }
        if (Regex.IsMatch(text, @"\bwho (are|r) (my|our|your) (minecraft |game )?(friends|crew|squad)\b|\bwho have (we|you) (met|played with)\b", RegexOptions.IgnoreCase))
        {
            capri.Say(FriendList());
            return true;
        }
        if (Regex.IsMatch(text, @"\b(minecraft|bedrock|mc) (status|link|connection)\b|\bare you (connected|in) (to )?(minecraft|the game)\b", RegexOptions.IgnoreCase))
        {
            capri.Say(status);
            return true;
        }
        return Connected && (OwnWord(text) || Order(text));
    }

    // ---------------------------------------------------------------- her jobs
    private bool Order(string text)
    {
        for (int i = 0; i < MinecraftJobs.GetLength(0); i++)
        {
            Match said = Regex.Match(text, MinecraftJobs[i, 0], RegexOptions.IgnoreCase);
            if (!said.Success) continue;
            string arg = MinecraftJobs[i, 2].Contains("$") ? Regex.Replace(said.Result(MinecraftJobs[i, 2]).ToLowerInvariant(), @"\s+", " ").Trim() : MinecraftJobs[i, 2];   // a player's name, a biome or a block
            string job = MinecraftJobs[i, 1];
            // "teleport sam to you": you is Capri.
            if (job == "send" || job == "tp") arg = Regex.Replace(arg, @"(^| )(you|yourself|u|her|herself|your|you're)$", "$1capri");
            Send(job, arg);
            return true;
        }
        return false;
    }

    private void Send(string job, string arg)
    {
        string shown = Regex.IsMatch(arg, "^(friend|buddy|mate|bro|homie|pal)$") ? "your " + arg : arg;     // "hacking your friend"
        string quick = QuickLine(job == "hack" && arg.Length > 0 ? "hack_player" : job, shown) ?? "on it!";
        string line = "scriptevent capri:" + job + (arg.Length > 0 ? " " + arg : "");
        bool live = FeedLive;
        ThreadPool.QueueUserWorkItem(delegate { Command(line); if (!live) Chat(quick); });
        lock (gate) { sentAt = Now; spokeAt = Now; spokeUntil = Now + 1 + quick.Length / 13.0; }
        capri.Say(quick);
    }

    // Their own words (the add-on's Mainframe > MY WORDS, in the feed): any phrase in any language for one of her jobs.
    // They come before her usual commands, and the longest phrase heard wins.
    private List<string[]> ownWords = new List<string[]>();

    private static string Plain(string text) { return Regex.Replace((text ?? "").ToLowerInvariant(), @"[\s\p{P}\p{S}]+", " ").Trim(); }

    private bool OwnWord(string text)
    {
        string said = " " + Plain(text) + " ";
        string[] hit = null;
        lock (gate)
            foreach (string[] word in ownWords)
                if (word[0].Length > 0 && said.Contains(" " + word[0] + " ") && (hit == null || word[0].Length > hit[0].Length)) hit = word;
        if (hit == null) return false;
        Send(hit[1], hit[2]);
        return true;
    }

    private void ReadWords(object value)
    {
        List<object> list = value as List<object>;
        if (list == null) return;
        List<string[]> read = new List<string[]>();
        foreach (object item in list)
        {
            List<object> entry = item as List<object>;
            if (entry == null || entry.Count < 2) continue;
            string job = Convert.ToString(entry[1]);
            if (!Regex.IsMatch(job, "^[a-z]+$")) continue;
            read.Add(new[] { Plain(Convert.ToString(entry[0])), job, entry.Count > 2 ? Regex.Replace(Convert.ToString(entry[2]).ToLowerInvariant(), @"[^\p{L}\p{N}_ ]+", "").Trim() : "" });
        }
        ownWords = read;
    }

    // Game chat: one of their own words starts that job; otherwise a line with her name in it is an order to her body.
    private void GameChat(string from, string said)
    {
        said = said.Trim();
        if (said.Length == 0) return;
        if (OwnWord(said)) { lock (gate) userAt = Now; return; }
        if (!Regex.IsMatch(said, @"\bcapri\b", RegexOptions.IgnoreCase)) return;
        lock (gate) userAt = Now;
        Order(said);
    }

    private static readonly string[] DiedLines = { "noo choom! get back up", "rip... i'll remember where your stuff is", "ouch, that looked like it hurt", "respawn and we go again!", "that one doesn't count" };
    private static readonly string[] KillLines = { "nice hit!", "deleted, love it", "clean kill, choom", "one less problem" };

    private void GameEvent(string name, Dictionary<string, object> body)
    {
        if (name == "PlayerDied") React(DiedLines, 1.0);
        else if (name == "MobKilled") React(KillLines, FeedLive ? 0.1 : 0.25);
    }

    private void React(string[] lines, double chance)
    {
        lock (gate)
        {
            if (talk == 0 || Now - reactedAt < 20 || random.NextDouble() > chance) return;
            reactedAt = Now;
            Speak(lines[random.Next(lines.Length)], true);
        }
    }

        private const string Mobs = @"(it|that|them|this|those|these|mobs?|monsters?|zombies?|skeletons?|spiders?|creepers?|witch(es)?|drowned|husks?|strays?|endermen|enderman|slimes?|phantoms?|pillagers?|everything)";
        // "kill <mob>": the kinds she hunts down by name (longer names first, so "zombie villager" isn't read as "zombie").
        private const string KillMobs = @"(zombie villagers?|zombified piglins?|wither skeletons?|cave spiders?|magma cubes?|zombies?|husks?|drowned|skeletons?|skellies|strays?|bogged|spiders?|creepers?|witch(es)?|endermen|enderman|endermites?|slimes?|phantoms?|pillagers?|vindicators?|evokers?|vex(es)?|ravagers?|blazes?|ghasts?|piglins?|hoglins?|zoglins?|silverfish|guardians?|shulkers?|breezes?|wardens?|monsters?|mobs|hostiles|everything|cows?|pigs?|sheep|chickens?|rabbits?|goats?|squids?|bats?|foxes|fox|llamas?|turtles?|frogs?|cod|salmon)";
